{
  "name": "copper-frying-pan",
  "description": "Copper Frying Pan — handcrafted solid-copper goods storefront (Qwik + Tailwind v3 + Vite + Three.js)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.17.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "8.10.2"
    }
  },
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "preview": "vite preview",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@types/node": "^20.0.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-imagetools": "^9.0.3"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
